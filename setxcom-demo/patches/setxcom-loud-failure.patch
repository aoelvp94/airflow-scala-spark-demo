+
+import com.fasterxml.jackson.databind.ObjectMapper
+import com.fasterxml.jackson.databind.module.SimpleModule
+import org.apache.airflow.sdk.execution.ModuleEncoded
+import org.apache.airflow.sdk.execution.TestValueModule
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.DisplayName
+import org.junit.jupiter.api.Test
+
+class JacksonModulesTest {
+  /** Fails like a module built for another Jackson version. */
+  private class FailingModule : SimpleModule("FailingModule") {
+    override fun setupModule(context: SetupContext): Unit = throw IllegalStateException("incompatible Jackson version")
+  }
+
+  @Test
+  @DisplayName("registerDiscoveredModules skips a module that fails to register and registers the rest")
+  fun registerDiscoveredModulesSkipsFailingModules() {
+    val mapper = ObjectMapper().registerDiscoveredModules(listOf(FailingModule(), TestValueModule()))
+
+    assertEquals("\"encoded by TestValueModule\"", mapper.writeValueAsString(ModuleEncoded()))
+  }
+}
