+import com.fasterxml.jackson.databind.SerializerProvider
+import com.fasterxml.jackson.databind.module.SimpleModule
+import com.fasterxml.jackson.databind.ser.std.StdSerializer
+
+/**
+ * Registered through `META-INF/services/com.fasterxml.jackson.databind.Module`,
+ * the way a bundle picks up a module such as `jackson-module-scala`.
+ */
+class TestValueModule : SimpleModule("TestValueModule") {
+  init {
+    addSerializer(
+      ModuleEncoded::class.java,
+      object : StdSerializer<ModuleEncoded>(ModuleEncoded::class.java) {
+        override fun serialize(
+          value: ModuleEncoded,
+          gen: JsonGenerator,
+          provider: SerializerProvider,
+        ) = gen.writeString("encoded by TestValueModule")
+      },
+    )
+  }
+}
