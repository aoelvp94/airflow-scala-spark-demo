+package org.apache.airflow.sdk.internal
+
+import com.fasterxml.jackson.databind.Module
+import com.fasterxml.jackson.databind.ObjectMapper
+import org.apache.airflow.sdk.execution.Logger
+
+private val logger = Logger("org.apache.airflow.sdk.internal.JacksonModules")
+
+/**
+ * Registers [modules], by default every Jackson module on the classpath, and
+ * skips with a warning any module that fails to register, such as one built
+ * for a different Jackson version.
+ */
+internal fun ObjectMapper.registerDiscoveredModules(modules: Iterable<Module> = ObjectMapper.findModules()): ObjectMapper {
+  for (module in modules) {
+    try {
+      registerModule(module)
+    } catch (e: Exception) {
+      logger.warning(
+        "Skipping a Jackson module that failed to register",
+        mapOf("module" to module.moduleName, "error" to e.toString()),
+      )
+    }
+  }
+  return this
+}
